[Unit]
Description=invisible_dots agent: the Dot itself
After=network-online.target dot-agentd.service dot-desktop.service
Wants=network-online.target dot-agentd.service dot-desktop.service
RequiresMountsFor=/opt/invisible-dots

[Service]
Type=simple
User=dot
Group=dot
WorkingDirectory=/home/dot
Environment=HOME=/home/dot
Environment=NODE_ENV=production
# Browser identities start invisible-playwright-mcp on the Dot's desktop
# (architecture section 6), so the agent needs both of these.
Environment=DISPLAY=:0
Environment=PATH=/home/dot/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/bin/node /opt/invisible-dots/invisible-dots-agent.mjs
Restart=on-failure
RestartSec=2
# prepare-sleep closes the browsers before shutdown; a plain stop gets time to do the same.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
