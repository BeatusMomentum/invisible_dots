{
  "extends": "./tsconfig.base.json",
  "include": [
    "*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "guest/invisible-dots-agent/src/**/*.ts",
    "guest/invisible-dots-agent/test/**/*.ts",
    "guest/image-builder/src/**/*.ts",
    "guest/image-builder/test/**/*.ts",
    "guest-runtime/*/src/**/*.ts",
    "guest-runtime/*/test/**/*.ts",
    "tests/repo/**/*.ts",
    "tests/e2e/**/*.ts"
  ],
  // The engine's sources are upstream's files as imported, which do not
  // compile against this repository until they are adapted to it; the
  // exclusion ends with that adaptation (guest-runtime/engine/UPSTREAM.md).
  "exclude": ["node_modules", "apps/web", "guest-runtime/engine/src"]
}
