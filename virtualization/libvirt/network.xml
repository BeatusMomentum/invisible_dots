<!--
  The NAT network every Dot's NIC is attached to (architecture section 3.4).
  10.213.0.0/24 keeps clear of libvirt's default 192.168.122.0/24 and of the
  172.16.0.0/12 range Docker hands out. Defined by deploy/install.sh, or by
  virtualization/networking/ensure-network.sh.
-->
<network>
  <name>invisible-dots</name>
  <forward mode='nat'>
    <nat>
      <port start='1024' end='65535'/>
    </nat>
  </forward>
  <bridge name='idots0' stp='on' delay='0'/>
  <ip address='10.213.0.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='10.213.0.10' end='10.213.0.254'/>
    </dhcp>
  </ip>
</network>
