[Unit]
Description=invisible_dots control plane (API, scheduler, vm-manager)
Documentation=https://github.com/feder-cr/dots/blob/main/docs/architecture.md
After=network-online.target libvirtd.service docker.service
Wants=network-online.target libvirtd.service

[Service]
Type=simple
User=invisible-dots
Group=invisible-dots
# virsh on qemu:///system and /dev/kvm.
SupplementaryGroups=libvirt kvm
EnvironmentFile=/etc/invisible-dots/server.env
# /run/invisible-dots holds the per-Dot bridge sockets (architecture 3.2).
RuntimeDirectory=invisible-dots
RuntimeDirectoryMode=0750
WorkingDirectory=/var/lib/invisible-dots
# The bundle finds virtualization/ relative to itself, so it runs from the
# installed tree, never from a copy of the file alone.
ExecStart=/usr/bin/env node /usr/local/lib/invisible-dots/apps/api/dist/invisible-dots-server.mjs
Restart=on-failure
RestartSec=3
# The socat bridges are children of this process and stop with it; the VMs
# belong to libvirt and keep running. The next start reattaches to them.
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
