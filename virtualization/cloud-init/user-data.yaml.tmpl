#cloud-config
# NoCloud user-data of one Dot, rendered by apps/vm-manager. Every value
# between double braces is inserted as a quoted YAML scalar.
hostname: {{hostname}}
preserve_hostname: false
manage_etc_hosts: true

# The golden image already has the user (it owns the browser engine cache);
# this keeps its settings authoritative on every instance.
users:
  - name: dot
    gecos: invisible_dots agent
    shell: /bin/bash
    lock_passwd: true
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    groups: [audio, video]
disable_root: true
ssh_pwauth: false

write_files:
  # The Dot's identity and the one secret in the seed (architecture 4.2, 4.3).
  # Deferred so it runs after the users module has created `dot`.
  - path: /etc/invisible-dots/config.json
    owner: dot:dot
    permissions: "0600"
    defer: true
    content: {{bootConfigJson}}
  # Runs on every boot, not only the first, so that a new runtime ISO gets its
  # units installed after a plain VM restart.
  - path: /var/lib/cloud/scripts/per-boot/invisible-dots-runtime.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/sh
      set -eu
      mountpoint -q /opt/invisible-dots || mount /opt/invisible-dots
      exec /opt/invisible-dots/install.sh

# The runtime ISO, found by its volume label so the device name does not matter.
mounts:
  - [ {{runtimeDevice}}, /opt/invisible-dots, iso9660, "ro,nofail,x-systemd.device-timeout=30s", "0", "0" ]
