[Unit]
Description=invisible_dots web client
Documentation=https://github.com/feder-cr/dots/blob/main/docs/architecture.md
After=network-online.target invisible-dots-server.service
Wants=invisible-dots-server.service

[Service]
Type=simple
# The same user as the server: the web server reads api.token and adds it to
# every request it forwards, so the token never reaches the browser.
User=invisible-dots
Group=invisible-dots
EnvironmentFile=/etc/invisible-dots/server.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
WorkingDirectory=/usr/local/lib/invisible-dots/apps/web
ExecStart=/usr/bin/env node /usr/local/lib/invisible-dots/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
